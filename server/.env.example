PORT=3000
APP_VERSION=0.0.1
APP_ROLE=api
# Supabase pooler URL (runtime)
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_SUPABASE_DB_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
# Supabase migration URL (preferred direct host; if IPv6 is unavailable, use session pooler :5432)
DIRECT_URL=postgresql://postgres.PROJECT_REF:YOUR_SUPABASE_DB_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
JWT_ACCESS_SECRET=replace-with-strong-and-unique-access-secret
JWT_REFRESH_SECRET=replace-with-strong-and-unique-refresh-secret
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_EXPIRES_IN_SECONDS=604800
AUTH_BYPASS_IN_TEST=false
AUTH_ALLOW_DEV_BOOTSTRAP=false
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX_REQUESTS=30
WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
WEBHOOK_RATE_LIMIT_MAX_REQUESTS=300
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=true
TRUST_PROXY=false
API_REQUEST_BODY_LIMIT=1mb
SECURITY_HEADERS_ENABLED=true
AI_DEFAULT_PROVIDER=gemini
GEMINI_API_KEY=replace-with-real-key
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=12000
AI_MAX_RETRIES=1
WEBSITE_FETCH_TIMEOUT_MS=8000
WEBSITE_FETCH_MAX_PAGES=4
WEBSITE_FETCH_MAX_RESPONSE_BYTES=500000
WHATSAPP_SEND_MAX_RETRIES=2
WHATSAPP_SEND_RETRY_BASE_DELAY_MS=300
OUTBOUND_MIN_INTERVAL_MS=700
INBOUND_RATE_LIMIT_PER_WINDOW=120
INBOUND_RATE_LIMIT_WINDOW_MS=60000
EXECUTION_QUEUE_MAX_RETRIES=3
EXECUTION_QUEUE_RETRY_BASE_DELAY_MS=500
QUEUE_DRIVER=memory
REDIS_URL=
QUEUE_PREFIX=wse
QUEUE_INLINE_WORKERS=true
QUEUE_INBOUND_CONCURRENCY=5
QUEUE_AI_DECISION_CONCURRENCY=3
QUEUE_OUTBOUND_CONCURRENCY=5
QUEUE_JOB_REMOVE_ON_COMPLETE=500
QUEUE_JOB_REMOVE_ON_FAIL=1000

WHATSAPP_ACCESS_TOKEN=replace-with-meta-system-user-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=optional-business-account-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-with-webhook-verify-token
WHATSAPP_APP_SECRET=replace-with-meta-app-secret
WHATSAPP_WEBHOOK_SIGNATURE_REQUIRED=false
WHATSAPP_PROVIDER_TIMEOUT_MS=12000
META_GRAPH_API_VERSION=v21.0
INSTAGRAM_ACCESS_TOKEN=replace-with-instagram-graph-token
INSTAGRAM_USER_ID=replace-with-instagram-user-id
INSTAGRAM_GRAPH_API_VERSION=v21.0
INSTAGRAM_MEDIA_LIMIT=20
INSTAGRAM_PROVIDER_TIMEOUT_MS=12000

RESEND_API_KEY=replace-with-resend-api-key
EMAIL_PROVIDER_TIMEOUT_MS=10000
EMAIL_FROM_ADDRESS=notifications@yourdomain.com
APP_BASE_URL=http://localhost:5173
