generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum LeadStage {
  NEW       @map("new")
  QUALIFIED @map("qualified")
  HOT       @map("hot")
  LOST      @map("lost")
  SUPPORT   @map("support")
}

enum ConversationStatus {
  ACTIVE @map("active")
  CLOSED @map("closed")
}

enum WorkspaceRole {
  ADMIN  @map("admin")
  AGENT  @map("agent")
  VIEWER @map("viewer")
}

enum AiMode {
  AUTO_REPLY  @map("auto_reply")
  SUGGEST_ONLY @map("suggest_only")
  PAUSED      @map("paused")
}

enum SenderType {
  USER  @map("user")
  AI    @map("ai")
  HUMAN @map("human")
}

enum MessageDirection {
  INBOUND  @map("inbound")
  OUTBOUND @map("outbound")
}

enum MessageType {
  TEXT    @map("text")
  STATUS  @map("status")
  UNKNOWN @map("unknown")
}

enum MessageStatus {
  SENT      @map("sent")
  DELIVERED @map("delivered")
  READ      @map("read")
  RECEIVED  @map("received")
  UNKNOWN   @map("unknown")
}

enum NotificationType {
  LEAD_HOT        @map("lead_hot")
  HANDOFF_STARTED @map("handoff_started")
  REPLY_FAILED    @map("reply_failed")
  CONNECTION_ERROR @map("connection_error")
  DAILY_SUMMARY   @map("daily_summary")
  WEEKLY_SUMMARY  @map("weekly_summary")
  INFO            @map("info")
}

enum NotificationChannel {
  IN_APP @map("in_app")
  EMAIL  @map("email")
  BOTH   @map("both")
}

model Conversation {
  id              String             @id @default(uuid())
  workspaceId     String
  phoneNumber     String
  leadStage       LeadStage          @default(NEW)
  status          ConversationStatus @default(ACTIVE)
  aiMode          AiMode             @default(AUTO_REPLY)
  lastMessageAt   DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  messages        Message[]
  handoffSessions HandoffSession[]

  @@unique([workspaceId, phoneNumber])
  @@index([workspaceId, phoneNumber])
  @@map("conversations")
}

model Workspace {
  id              String             @id
  name            String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  members         WorkspaceMember[]

  @@map("workspaces")
}

model User {
  id             String             @id @default(uuid())
  email          String             @unique
  passwordHash   String
  displayName    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  memberships    WorkspaceMember[]

  @@map("users")
}

model WorkspaceMember {
  id           String        @id @default(uuid())
  workspaceId  String
  userId       String
  role         WorkspaceRole @default(AGENT)
  createdAt    DateTime      @default(now())
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId, workspaceId])
  @@map("workspace_members")
}

model Message {
  id                String           @id @default(uuid())
  conversationId    String
  externalMessageId String?          @unique
  senderType        SenderType
  direction         MessageDirection @default(INBOUND)
  messageType       MessageType      @default(UNKNOWN)
  content           String?
  rawPayload        Json
  status            MessageStatus    @default(UNKNOWN)
  timestamp         DateTime?
  createdAt         DateTime         @default(now())
  conversation      Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model InboundEventLog {
  id         String   @id @default(uuid())
  workspaceId String   @default("default-workspace")
  dedupKey   String   @unique
  rawPayload Json
  receivedAt DateTime @default(now())

  @@index([workspaceId, receivedAt])
  @@map("inbound_event_logs")
}

model BrandContext {
  id                 String    @id @default(uuid())
  workspaceId        String    @unique
  tone               String?
  salesStyle         String?
  dataJson           Json?
  sourceStatusJson   Json?
  websiteSignalsJson Json?
  instagramSignalsJson Json?
  resolvedContextJson Json?
  confidenceJson     Json?
  lastResolvedAt     DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("brand_contexts")
}

model TrainingSetting {
  id                     String   @id @default(uuid())
  workspaceId            String   @unique
  faqJson                Json?
  productsJson           Json?
  rulesJson              Json?
  forbiddenResponsesJson Json?
  handoffRulesJson       Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("training_settings")
}

model WebsiteAnalysisSnapshot {
  id                 String   @id @default(uuid())
  workspaceId        String
  rootUrl            String
  pagesJson          Json
  extractedSignalsJson Json
  confidence         Float?
  createdAt          DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@map("website_analysis_snapshots")
}

model InstagramAnalysisSnapshot {
  id                 String   @id @default(uuid())
  workspaceId        String
  instagramHandle    String
  profileJson        Json
  postsJson          Json
  extractedSignalsJson Json
  confidence         Float?
  createdAt          DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@map("instagram_analysis_snapshots")
}

model WhatsAppConnection {
  id                   String   @id @default(uuid())
  workspaceId          String   @unique
  phoneNumber          String
  accessTokenEncrypted String
  phoneNumberId        String
  businessAccountId    String?
  webhookVerifyToken   String?
  metadataJson         Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("whatsapp_connections")
}

model HandoffSession {
  id             String       @id @default(uuid())
  conversationId String
  startedAt      DateTime     @default(now())
  endedAt        DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, startedAt])
  @@map("handoff_sessions")
}

model AnalyticsEvent {
  id             String   @id @default(uuid())
  workspaceId    String
  conversationId String?
  type           String
  payloadJson    Json?
  createdAt      DateTime @default(now())

  @@index([workspaceId, type, createdAt])
  @@index([workspaceId, conversationId, createdAt])
  @@map("analytics_events")
}

model Notification {
  id         String              @id @default(uuid())
  workspaceId String
  userId     String?
  type       NotificationType
  channel    NotificationChannel @default(IN_APP)
  title      String
  message    String
  isRead     Boolean             @default(false)
  payloadJson Json?
  emailSentAt DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([workspaceId, createdAt])
  @@index([workspaceId, isRead, createdAt])
  @@index([workspaceId, userId, isRead, createdAt])
  @@map("notifications")
}

model AuditLog {
  id            String   @id @default(uuid())
  workspaceId   String?
  userId        String?
  action       String
  entityType   String?
  entityId     String?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model MessageTemplate {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  content     String
  isActive    Boolean  @default(true)
  usageCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  @@unique([workspaceId, name])
  @@index([workspaceId, isActive])
  @@map("message_templates")
}

model QueueFailureLog {
  id            String   @id @default(uuid())
  queueName     String
  jobId         String?
  workspaceId   String?
  conversationId String?
  payloadJson   Json?
  errorMessage  String
  errorStack    String?
  attempt       Int
  maxAttempts   Int
  failedAt      DateTime @default(now())

  @@index([queueName, failedAt])
  @@index([workspaceId, failedAt])
  @@index([conversationId, failedAt])
  @@map("queue_failure_logs")
}
